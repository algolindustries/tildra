    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.8",
    "expo-audio": "^57.0.3",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "^57.0.1",
    "expo-crypto": "^57.0.1",
    "expo-device": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-image-manipulator": "^57.0.7",
    "expo-image-picker": "^57.0.7",
    "expo-localization": "^57.0.1",
    "expo-notifications": "^57.0.8",
    "expo-secure-store": "^57.0.1",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vectors": "vitest run src/crypto",
    "bundle": "expo export --platform ios --output-dir .expo-export",
    "bundle:release": "scripts/bundle.sh dist",
    "reproduce": "scripts/reproduce.sh",
    "reproduce:native": "scripts/reproduce-native.sh",
    "check:native": "scripts/check-native-config.sh",
    "check:reachable": "node scripts/unreferenced-exports.mjs"
  },
  "private": true,
  "overrides": {
    "@config-plugins/react-native-webrtc": {
      "expo": "$expo"
    }
  }
