# Copy to .env and adjust. Every value here has a safe default except the
# database URL, which is deliberately empty so a fresh clone runs immediately.

# Listen address.
TILDRA_ADDR=:8080

# Postgres connection string. Leave empty to use the in-memory store, which is
# fine for development and unsuitable for production. Migrations are applied
# automatically on startup.
#
#   TILDRA_DATABASE_URL=postgres://tildra:tildra@localhost:5432/tildra?sslmode=disable
TILDRA_DATABASE_URL=

# Used only by `make test-postgres`. Never point this at a database you care
# about — the conformance suite creates and drops schemas.
TILDRA_TEST_DATABASE_URL=

# Hard ceiling on how long an undelivered envelope may sit on the server.
# Delivered envelopes are destroyed on ack regardless of this value.
TILDRA_ENVELOPE_TTL=720h

# Maximum size of a single message envelope. Media goes through the attachment
# store, not the message queue.
TILDRA_MAX_ENVELOPE_BYTES=262144

# How devices are woken when they are not connected: "expo" or "none".
# With "none" no push token is ever collected and clients receive on reconnect,
# which is a legitimate deployment rather than a degraded one.
TILDRA_PUSH_PROVIDER=none

# Bounds on encrypted attachments.
TILDRA_MAX_ATTACHMENT_BYTES=33554432
TILDRA_ATTACHMENT_TTL=168h

# Base64 Ed25519 seed (32 bytes) the key transparency log signs tree heads with.
# Empty disables the log; handle lookups then carry no proof and key
# substitution is detectable only by comparing safety numbers.
#
# Generate with:  head -c 32 /dev/urandom | base64
#
# Hold this outside the database. A signing key sitting next to the log it
# signs can be used to rewrite the whole thing.
TILDRA_TRANSPARENCY_KEY=
